# Environment variables (Vercel: Settings -> Environment Variables;
# Netlify: Site settings -> Environment variables). Never commit real values.

# --- always required ---

# Production origin, e.g. https://your-domain.example — requests from other
# origins are rejected. No trailing slash. Comma-separate to allow several.
ALLOWED_ORIGIN=

# Random salt for one-way IP hashing (abuse control); rotate to invalidate old hashes
IP_HASH_SALT=

# --- lead delivery: configure AT LEAST ONE of the two blocks below ---
# A submission succeeds when any configured sink accepts it. Set both and the
# lead is delivered twice (Sheet row + Telegram message).

# Option 1 — Telegram (fastest to set up; see docs/SETUP_RU.md part А-Т)
# Token from @BotFather, numeric chat id from @userinfobot.
# You must press Start on your own bot before it can message you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option 2 — Google Sheet via Apps Script (see README / docs/SETUP_RU.md part А-G)
# Web-app URL, ends with /exec
APPS_SCRIPT_WEBHOOK_URL=
# Long random string; must equal the SHARED_SECRET Script Property in Apps Script
APPS_SCRIPT_SHARED_SECRET=

# --- optional ---

# Google PageSpeed Insights API key for /api/site-audit. Without it the check
# still runs and reports our own speed measurements; with it, Google's lab
# metrics are added on top. https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
